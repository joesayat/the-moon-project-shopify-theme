<!-- STYLES -->
{{ 'type-navigation.css' | asset_url | stylesheet_tag }}

<nav class="type-nav">
  <ul class="type-list">

    <!-- ALL -->
    <li class="type-item">
      <a
        class="type-link {% if collection.handle == 'all' %}active{% endif %}"
        href="{{ collections.all.url }}"
      >
        All
      </a>
    </li>

    <!-- COSMIC ESSENTIALS -->
    <li class="type-item">
      <a
        class="type-link {% if collection.handle == 'cosmic-essentials' %}active{% endif %}"
        href="{{ collections['cosmic-essentials'].url }}"
      >
        Cosmic Essentials
      </a>
    </li>

    <!-- HATS -->
    <li class="type-item">
      <a
        class="type-link {% if collection.handle == 'hats' %}active{% endif %}"
        href="{{ collections['hats'].url }}"
      >
        Hats
      </a>
    </li>

    <!-- PULLOVERS -->
    <li class="type-item">
      <a
        class="type-link {% if collection.handle == 'hoodies' %}active{% endif %}"
        href="{{ collections['hoodies'].url }}"
      >
        Pullovers
      </a>
    </li>

    <!-- SOCKS -->
    <li class="type-item">
      <a
        class="type-link {% if collection.handle == 'accessories' %}active{% endif %}"
        href="{{ collections['accessories'].url }}"
      >
        Socks
      </a>
    </li>

    <!-- SHORTS -->
    <li class="type-item">
      <a
        class="type-link {% if collection.current_type == 'Shorts' %}active{% endif %}"
        href="{{ 'Shorts' | url_for_type }}"
      >
        Shorts
      </a>
    </li>

    <!-- TEES -->
    <li class="type-item">
      <a
        class="type-link {% if collection.handle == 'tees' %}active{% endif %}"
        href="{{ collections['tees'].url }}"
      >
        Tees
      </a>
    </li>

  </ul>
</nav>