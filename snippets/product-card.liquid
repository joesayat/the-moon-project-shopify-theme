<li class="product-description__collection relative">
  {% if product.category == 'Socks' or product.category == 'Coasters' or product.category == 'Door Mats' %}
    <div class="img-container__collection overflow-hidden">
      <img
        class="product-img__collection"
        name="img-featured"
        src="{{ product.featured_image | image_url }}"
        width="120"
        height="150"
        alt="{{ product.featured_image.alt}}"
      >
    </div>
  {% else %}
    <div class="img-container__collection">
      <img
        class="product-img__collection"
        name="img-back"
        src="{{ product.images[1] | image_url }}"
        width="120"
        height="150"
        alt="{{ product.images[1].alt}}"
      >
    </div>
    <img
      class="product-img__collection"
      name="img-front"
      src="{{ product.images[0] | image_url }}"
      width="120"
      height="150"
      alt="{{ product.images[0].alt}}"
    >
  {% endif %}
  <div class="product-card__tag-container">
    {% for tag in product.tags %}
      {% assign tag_downcase = tag | downcase %}
      {% case tag_downcase %}
        {% when 'sale' %}
          <p class="product-card__tag product-card__tag--sale">{{ tag_downcase }}</p>
        {% when 'limited stocks' %}
          <p class="product-card__tag product-card__tag--limited-stocks">{{ tag_downcase }}</p>
        {% when 'new release' %}
          <p class="product-card__tag product-card__tag--new-release">{{ tag_downcase }}</p>
        {% else %}

      {% endcase %}
    {% endfor %}
  </div>
  <h3 class="product-name__collection bold">{{ product.title }}</h3>
  <p class="product-price__collection">{{ product.price | money }}</p>
  <a class="product-link__collection" href="{{ product.url }}"></a>
</li>
