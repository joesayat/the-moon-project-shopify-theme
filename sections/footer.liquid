<!-- FOOTER STYLES -->
{{ 'footer.css' | asset_url | stylesheet_tag }}

<!-- VARIABLES -->
{% if section.settings.footer_shopping_list == blank %}
  {% assign shopping_linklists = linklists['footer-shopping-menu'] %}
{% else %}
  {% assign shopping_linklists = linklists[section.settings.footer_shopping_list] %}
{% endif %}

{% if section.settings.footer_company_list == blank %}
  {% assign company_linklists = linklists['footer-company-menu'] %}
{% else %}
  {% assign company_linklists = linklists[section.settings.footer_company_list] %}
{% endif %}

{% if section.settings.instagram_url == blank %}
  {% assign instagram_url = 'https://www.instagram.com/themoonprojectph/' %}
{% else %}
  {% assign instagram_url = section.settings.instagram_url %}
{% endif %}

{% if section.settings.facebook_url == blank %}
  {% assign facebook_url = 'https://facebook.com/themoonprojectph' %}
{% else %}
  {% assign facebook_url = section.settings.facebook_url %}
{% endif %}

{% if section.settings.spotify_url == blank %}
  {% assign spotify_url = 'https://open.spotify.com/user/31kt54g6vwyoedvp2hdp2nfpnvye?si=t_3ygD0wRF6Ki1bm49IpsA' %}
{% else %}
  {% assign spotify_url = section.settings.spotify_url %}
{% endif %}

<style>
  .footer .heading-2 {
    color: var(--white);
  }

  .footer__newsletter {
    margin: 4rem 0 12rem;
  }

  .form {
    width: 100%;
    text-align: center;
  }

  .form__group {
    display: inline-block;
  }

  /* TODO: use grid on parent for responsive sizing*/
  .form__input {
    font-size: 1.6rem;
    font-family: 'Roboto Condensed', sans-serif;
    font-weight: 600;
    letter-spacing: 1px;
    width: 52rem;
    padding: 1.2rem;
    border: none;
    outline: 1px solid transparent;
  }

  .form__input::placeholder {
    color: var(--gray-darkest);
  }

  .form__btn {
    font-family: 'Roboto Condensed', sans-serif;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.16rem;
    text-transform: uppercase;
    padding: 1.2rem 4rem;
    background-color: var(--main);
    color: var(--white);
    transition: all 0.3s ease-out;
  }

  .form__btn:hover {
    background-color: var(--main-dark);
  }

  .form__input:not(:placeholder-shown):valid {
    outline-color: var(--green);
  }

  .form__input:not(:placeholder-shown):invalid {
    outline-color: var(--red);
  }

  .form__input:focus:invalid {
    outline-color: var(--yellow);
  }

  /* TODO: testing margin height of form notification */
  .form__notification {
    margin-top: 1.2rem;
  }

  /*******************************/
  /* BELOW 768px (Small Tablets) */
  /*******************************/
  @media (max-width: 48em) {
    .form {
      width: 100%;
    }

    .form__input {
      width: 40rem;
    }
  }

  /************************/
  /* BELOW 656px (Phones) */
  /************************/
  @media (max-width: 41em) {
    .form__group {
      display: block;
    }

    .form__input {
      width: 100%;
    }

    .form__btn {
      width: 100%;
      margin-top: 0.4rem;
    }
  }
</style>

<!-- FOOTER -->
<footer class="footer tmp-footer">
  <div class="container">
    <p class="subheading">Newsletter</p>
    <h2 class="heading-2">Want to know what we're up to?</h2>
    <div class="footer__newsletter">
      {% form 'customer', class: 'form' %}
        {% if form.errors %}
          {% for error in form.errors %}
            <div class="form__notification">
              {% render 'icon-error-alert' %}
              <span>
                {{ error | capitalize }}
                {{ form.errors.messages[error] }}
              </span>
            </div>
          {% endfor %}
        {% elsif form.posted_successfully? %}
          <div class="form__notification">{% render 'icon-success-alert' %} Sent successfully</div>
        {% endif %}

        <div class="form__group">
          <input
            type="email"
            name="contact[email]"
            placeholder="Your email"
            class="form__input"
            pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
          >
        </div>
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="form__group">
          <button type="submit" class="form__btn">Subscribe</button>
        </div>
      {% endform %}
    </div>
  </div>
  <div class="container grid grid-4-col grid-footer">
    <!-- FOOTER LOGO ICON -->
    <div class="footer-col">
      <div class="footer-logo-icon">
        <img
          class="footer-logo-img"
          src="{{ shop.brand.square_logo | image_url }}"
          alt="The Moon Project icon"
          width="auto"
          height="auto"
        >
      </div>
    </div>

    <!-- FOOTER SHOPPING NAV -->
    <div class="footer-col">
      <p class="heading-footer">Shopping</p>
      <nav class="footer-nav" role="navigation">
        <ul class="footer-list">
          {% for link in shopping_linklists.links %}
            <li class="footer-item">
              <a class="link__footer" href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>

    <!-- FOOTER COMPANY NAV -->
    <div class="footer-col">
      <p class="heading-footer">Company</p>
      <nav class="footer-nav" role="navigation">
        <ul class="footer-list">
          {% for link in company_linklists.links %}
            <li class="footer-item">
              <a class="link__footer" href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>

    <!-- FOOTER FOLLOW NAV -->
    <div class="footer-col">
      <p class="heading-footer">Follow us</p>
      <nav class="footer-nav" role="navigation">
        <ul class="footer-icon-list">
          <li class="footer-item">
            <a
              class="link__footer-icon"
              href="{{ instagram_url }}"
              target="_blank"
            >
              {% render 'icon-instagram', size: '2.4rem' %}
            </a>
          </li>
          <li class="footer-item">
            <a
              class="link__footer-icon"
              href="{{ facebook_url }}"
              target="_blank"
            >
              {% render 'icon-facebook', size: '2.4rem' %}
            </a>
          </li>
          <li class="footer-item">
            <a
              class="link__footer-icon"
              href="{{ spotify_url }}"
              target="_blank"
            >
              {% render 'icon-spotify', size: '2.4rem' %}
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <!-- FOOTER COPYRIGHT -->
  <div class="footer-container container">
    <p class="footer-copyright">
      &copy; {{ 'now' | date: '%Y' }},
      <span class="footer-logo-text">The Moon Project Ph</span>
      Powered by Shopify
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "footer_shopping_list",
      "label": "Footer Shopping Menu"
    },
    {
      "type": "link_list",
      "id": "footer_company_list",
      "label": "Footer Company Menu"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "spotify_url",
      "label": "Spotify URL"
    }
  ]
}
{% endschema %}
