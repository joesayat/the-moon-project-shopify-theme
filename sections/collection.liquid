<!-- COLLECTION STYLES -->
{{ 'collection.css' | asset_url | stylesheet_tag }}

<!-- VARIABLES -->
{% if collection.handle == 'all' %}
  {% assign featured_collection = collections.frontpage %}
{% else %}
  {% assign featured_collection = collection %}
{% endif %}

{% assign products_size = featured_collection.products | size %}

<!-- DOOM SCROLL SETTINGS -->
{% assign doom_scroll = false %}

{% if collection.handle == 'tees'
  or collection.handle == 'hoodies'
  or collection.handle == 'hats'
  or collection.handle == 'accessories'
  or collection.handle == 'cosmic-essentials'
%}
  {% assign doom_scroll = true %}
{% endif %}

{% if doom_scroll %}
  {% assign products_per_page = 250 %}
{% else %}
  {% assign products_per_page = section.settings.product_count %}
{% endif %}

<!-- SECTION SHOP -->
{% if products_size > 0 %}

  <!-- TYPE NAVIGATION -->
  {% case featured_collection.handle %}

    {% when 'frontpage' %}
      {% render 'type-navigation', featured_collection: featured_collection %}

    {% when 'types' %}
      {% render 'type-navigation', featured_collection: collections.all %}

    {% when 'cosmic-essentials' %}
      {% render 'type-navigation', featured_collection: collections.all %}

    {% when 'hats' %}
      {% render 'type-navigation', featured_collection: collections.all %}

    {% when 'hoodies' %}
      {% render 'type-navigation', featured_collection: collections.all %}

    {% when 'accessories' %}
      {% render 'type-navigation', featured_collection: collections.all %}

    {% when 'tees' %}
      {% render 'type-navigation', featured_collection: collections.all %}

    {% else %}
      <div class="heading-container__pages">
        <p class="subheading">Collection</p>
        <h2 class="heading-2">{{ featured_collection.title }}</h2>
      </div>

  {% endcase %}

  <section class="section__collection">
    <div class="container">

      <!-- PRODUCT GRID -->
      {% paginate collection.products by products_per_page %}

        <div class="product-grid">
          <ul class="product-list__collection grid grid-{{ section.settings.column_count }}-col">

            <!-- PRODUCT CARD -->
            {% for product in collection.products %}
              {% render 'product-card', product: product %}
            {% endfor %}

          </ul>
        </div>

        <!-- PAGINATION -->
        {% unless doom_scroll %}
          {% render 'pagination', pagination: paginate %}
        {% endunless %}

      {% endpaginate %}

    </div>
  </section>

{% else %}

  {% render 'error-no-products' %}

{% endif %}

<!-- SCHEMA -->
{% schema %}
{
  "name": "Shop Grid",
  "settings": [
    {
      "type": "range",
      "id": "product_count",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 6,
      "label": "Product Count"
    },
    {
      "type": "range",
      "id": "column_count",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "Column Count"
    }
  ]
}
{% endschema %}