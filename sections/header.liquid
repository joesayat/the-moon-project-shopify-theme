<!-- HEADER STYLES -->
{{ 'header.css' | asset_url | stylesheet_tag }}

<!-- HEADER SCRIPT -->
<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>

<!-- VARIABLES -->
{% assign nav_linklists = linklists[section.settings.nav_list] %}

<!-- HEADER -->
<header-nav>
  <header class="header tmp-header bold relative">

    <!-- LOGO -->
    <div class="header-logo">
      <a href="{{ routes.root_url }}">
        <img
          class="header-logo-img"
          src="{{ shop.brand.logo | image_url }}"
          alt="The Moon Project logo"
          width="auto"
          height="auto"
        >
      </a>
    </div>

    <!-- DESKTOP NAV -->
    <nav class="header-nav">
      <ul class="header-list">

        {% for link in nav_linklists.links %}
          {% assign link_title_downcase = link.title | downcase %}

          {% if link_title_downcase == 'shop' %}

            <!-- SHOP DROPDOWN -->
            <li class="header-item header-item--dropdown">

              <a
                class="header-link tmp-link__header {% if link.active %} active {% endif %}"
                href="{{ link.url }}"
                aria-haspopup="true"
              >
                {{ link.title }}
              </a>

              <div class="header-shop-dropdown">
                <ul class="header-shop-dropdown__list">

                  <!-- ALL -->
                  <li class="header-shop-dropdown__item">
                    <a
                      class="header-shop-dropdown__link"
                      href="{{ collections.all.url }}"
                    >
                      All
                    </a>
                  </li>

                  <!-- TEES -->
                  <li class="header-shop-dropdown__item">
                    <a
                      class="header-shop-dropdown__link"
                      href="{{ collections['tees'].url }}"
                    >
                      Tees
                    </a>
                  </li>

                  <!-- SWEATER -->
                  <li class="header-shop-dropdown__item">
                    <a
                      class="header-shop-dropdown__link"
                      href="{{ collections['hoodies'].url }}"
                    >
                      Sweater
                    </a>
                  </li>

                  <!-- HATS -->
                  <li class="header-shop-dropdown__item">
                    <a
                      class="header-shop-dropdown__link"
                      href="{{ collections['hats'].url }}"
                    >
                      Hats
                    </a>
                  </li>

                  <!-- BOTTOMS -->
                  <li class="header-shop-dropdown__item">
                    <a
                      class="header-shop-dropdown__link"
                      href="{{ collections['bottoms'].url }}"
                    >
                      Bottoms
                    </a>
                  </li>

                  <!-- SOCKS -->
                  <li class="header-shop-dropdown__item">
                    <a
                      class="header-shop-dropdown__link"
                      href="{{ collections['accessories'].url }}"
                    >
                      Socks
                    </a>
                  </li>

                  <!-- COSMIC ESSENTIALS -->
                  <li class="header-shop-dropdown__item">
                    <a
                      class="header-shop-dropdown__link"
                      href="{{ collections['cosmic-essentials'].url }}"
                    >
                      Cosmic Essentials
                    </a>
                  </li>

                  <!-- DIVIDER -->
                  <li
                    class="header-shop-dropdown__divider"
                    aria-hidden="true"
                  ></li>

                  <!-- FUTURE COLLECTION SECTION -->
                  <li class="header-shop-dropdown__heading">
                    Browse by Collection:
                  </li>

                </ul>
              </div>

            </li>

          {% else %}

            <!-- NORMAL DESKTOP NAV ITEM -->
            <li class="header-item">
              <a
                class="header-link tmp-link__header {% if link.active %} active {% endif %}"
                href="{{ link.url }}"
              >
                {{ link.title }}
              </a>
            </li>

          {% endif %}
        {% endfor %}

      </ul>
    </nav>

    <!-- MOBILE NAV -->
    <nav class="header-nav__md tmp-nav__md">
      <ul class="header-list__md">
        {% for link in nav_linklists.links %}
          <li class="header-item__md">
            <a
              class="header-link__md tmp-link__header__md {% if link.active %} active {% endif %}"
              href="{{ link.url }}"
            >
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <!-- ICONS -->
    <div class="header-icons">

      <!-- DESKTOP SEARCH -->
      <form
        class="header-search"
        action="{{ routes.search_url }}"
        method="get"
        role="search"
      >
        <span class="header-search__icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
          </svg>
        </span>

        <input
          class="header-search__input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search products..."
          aria-label="Search products"
        >

        <input
          type="hidden"
          name="type"
          value="product"
        >
      </form>

      <!-- MOBILE SEARCH BUTTON -->
      <div class="header-icon header-search-toggle">
        <button
          class="tmp-icon__header"
          type="button"
          name="header-search-toggle"
          aria-label="Open search"
          aria-expanded="false"
        >
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
          </svg>
        </button>
      </div>

      <!-- CART -->
      <div class="header-icon">
        <a
          class="tmp-icon__header {% if canonical_url contains routes.cart_url %} active {% endif %}"
          href="{{ routes.cart_url }}"
        >
          {% render 'icon-shopping-bag' %}
        </a>
      </div>

      <!-- MOBILE MENU -->
      <div class="header-icon">
        <button
          class="tmp-icon__header"
          type="button"
          name="header-menu"
          aria-label="Open menu"
        >
          {% render 'icon-menu' %}
          {% render 'icon-close' %}
        </button>
      </div>

    </div>

  </header>

  <!-- MOBILE SEARCH PANEL -->
  <div class="header-search-mobile">
    <form
      class="header-search-mobile__form"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
    >
      <span class="header-search-mobile__icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
        </svg>
      </span>

      <input
        class="header-search-mobile__input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products..."
        aria-label="Search products"
      >

      <input
        type="hidden"
        name="type"
        value="product"
      >
    </form>
  </div>

  <!-- OVERLAY -->
  <div class="overlay"></div>
</header-nav>

<!-- SCHEMA -->
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "nav_list",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}